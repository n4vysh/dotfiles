#!/bin/sh

set -eu

# chezmoi template variables
cat <<-'EOF' >/dev/null
	{{- $isWSL := eq (stat "/usr/bin/wslinfo" | default (dict "type" "")).type "file" }}
	{{- $platform := ternary "wsl" "linux" $isWSL }}
	$isWSL={{ $isWSL }}
	$platform={{ $platform }}
EOF

gum log --level info 'Enable system services'
sudo systemctl daemon-reload
xargs -r sudo systemctl enable <<-'EOF'
	{{ range (index .services $platform).systemd.system.enabled | jq "flatten | .[]" | uniq -}}
	{{ . }}
	{{ end -}}
EOF

gum log --level info 'Start system services'
xargs -r sudo systemctl start <<-'EOF'
	{{ range (index .services $platform).systemd.system.running | jq "flatten | .[]" | uniq -}}
	{{ . }}
	{{ end -}}
EOF

gum log --level info 'Enable user services'
systemctl --user daemon-reload
xargs -r systemctl --user enable <<-'EOF'
	{{ range (index .services $platform).systemd.user.enabled | jq "flatten | .[]" | uniq -}}
	{{ . }}
	{{ end -}}
EOF

gum log --level info 'Start user services'
xargs -r systemctl --user start <<-'EOF'
	{{ range (index .services $platform).systemd.user.running | jq "flatten | .[]" | uniq -}}
	{{ . }}
	{{ end -}}
EOF

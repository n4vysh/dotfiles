#!/bin/sh

set -eu

if ! [ -f /usr/bin/wslinfo ]; then
	gum log --level warn "$0: not running on WSL -- skipping"
	exit 0
fi

gum log --level info 'Configure locale'
sudo sed -i -e '/^#en_US.UTF-8 UTF-8  $/s/#//' /etc/locale.gen
sudo locale-gen

gum log --level info 'Enable progress bar of pacman'
sudo sed -i -e '/^#NoProgressBar$/s/#//' /etc/pacman.conf

gum log --level info 'Copy etc files'
xargs -I {} sudo install -C -D -v -m 0440 -o root -g root ~/.local/share/chezmoi/system/{} /{} <<-EOF
	etc/sudoers.d/env-keep
	etc/sudoers.d/pwfeedback
	etc/sudoers.d/wheel
EOF

# https://learn.microsoft.com/en-us/windows/wsl/wsl-config#configuration-setting-for-wslconfig
sudo install -C -D -v -m 0644 -o root -g root \
	~/.local/share/chezmoi/system/etc/wsl.conf \
	/etc/wsl.conf

# NOTE: fix clock sync bug of WSL
# https://github.com/microsoft/WSL/issues/8204#issuecomment-1339506778
sudo install -C -D -v -m 0644 -o root -g root \
	~/.local/share/chezmoi/system/etc/systemd/system/systemd-timesyncd.service.d/override.conf \
	/etc/systemd/system/systemd-timesyncd.service.d/override.conf

# NOTE: run a script when etc file changes
# https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/#run-a-script-when-the-contents-of-another-file-changes
# https://github.com/twpayne/chezmoi/issues/4364
# https://github.com/alker0/chezmoi.vim/issues/76
cat <<-EOF >/dev/null
	{{ include (joinPath .chezmoi.sourceDir "../system/etc/wsl.conf") | sha256sum }}
	{{ include (joinPath .chezmoi.sourceDir "../system/etc/systemd/system/systemd-timesyncd.service.d/override.conf") | sha256sum }}

	{{ include (joinPath .chezmoi.sourceDir "../system/etc/sudoers.d/env-keep") | sha256sum }}
	{{ include (joinPath .chezmoi.sourceDir "../system/etc/sudoers.d/pwfeedback") | sha256sum }}
	{{ include (joinPath .chezmoi.sourceDir "../system/etc/sudoers.d/wheel") | sha256sum }}
EOF

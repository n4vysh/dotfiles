#!/bin/sh

# {{ $localappdata := "" }}
# {{ if and (eq .chezmoi.os "linux") (eq (stat "/usr/bin/wslinfo" | default (dict "type" "")).type "file") }}
# {{ $localappdata = output "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" "-NoProfile" "-NonInteractive" "$env:LOCALAPPDATA" | trim | output "wslpath" | trim }}
# {{ end }}

set -eu

IFS= read -r localappdata <<-'EOF'
	{{ $localappdata }}
EOF

IFS= read -r title_b64
IFS= read -r message_b64

# HACK: hide default app logo with fake image
#       redirect warning message to null
#       https://github.com/Windos/BurntToast/issues/150
exec "$localappdata/Microsoft/WindowsApps/pwsh.exe" \
	-NoProfile \
	-NonInteractive \
	-Command "
		\$title = [Text.Encoding]::UTF8.GetString(
			[Convert]::FromBase64String('$title_b64')
		)
		\$message = [Text.Encoding]::UTF8.GetString(
			[Convert]::FromBase64String('$message_b64')
		)

		New-BurntToastNotification \
			-Text \$title, \$message \
			-AppLogo 'C:\fake.png' \
			3>\$null
	"

# local dependencies
.config/opencode/node_modules
.config/opencode/node_modules/**

# chezmoi scripts
{{ if eq (env "CI") "true" }}
.chezmoiscripts/**
{{ else }}
{{   if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux/**
{{   else if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
{{   end }}
{{ end }}

# dotfiles for WSL
{{ if eq .chezmoi.os "windows" }}
.*
.local/bin/* # ignore chezmoi external
.local/share/** # ignore chezmoi external
.tmux/plugins/** # ignore chezmoi external
!.wslconfig
!.glzr
!.config
.config/*
!.config/wezterm
!.config/yasb
{{ end }}

# dotfiles for linux
{{ if ne .chezmoi.os "windows" }}
.wslconfig
.glzr
.config/wezterm
.config/yasb
{{ end }}
{{ if eq .chezmoi.os "linux" }}
{{   if not (eq (stat "/usr/bin/wslinfo" | default (dict "type" "")).type "file") }}
.local/bin/*.exe
.local/bin/*.ps1
.local/bin/wsl-*
.config/systemd/user/wsl-*
.config/nono/profiles/wsl.jsonc
{{   end }}
{{ end }}

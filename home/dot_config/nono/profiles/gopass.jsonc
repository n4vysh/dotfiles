{
  "$schema": "../nono-profile.schema.json",
  "extends": "gpg",
  "command_policies": {
    "commands": {
      "gopass": {
        "can_use": ["gpg"],
        "from": {
          "session": {
            "sandbox": {
              "fs_read": ["$HOME/.password-store", "$XDG_CONFIG_HOME/gopass"],
              "environment": {
                "allow_vars": ["HOME"]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": {
                    "prefix": ["env"]
                  }
                },
                {
                  "argv": {
                    "exact": ["cat", "opencode/otlp_authz_header"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}

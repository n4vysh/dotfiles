{
  "$schema": "../nono-profile.schema.json",
  "extends": "granted",
  "command_policies": {
    "session_export_env": [
      "XDG_CONFIG_HOME",
      "XDG_CACHE_HOME",
      "XDG_STATE_HOME",
      "AWS_MCP_PROXY_PROFILES",
      "AWS_PROFILE",
      "AWS_REGION"
    ],
    "commands": {
      "mcp-proxy-for-aws": {
        "can_use": ["granted"],
        "export_env": [
          "HOME",
          "XDG_CONFIG_HOME",
          "XDG_CACHE_HOME",
          "XDG_STATE_HOME",
          "AWS_CONFIG_FILE",
          "AWS_PROFILE",
          "AWS_REGION"
        ],
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/etc/ssl",
                "/lib",
                "/lib64",
                "/usr/lib",
                "/usr/lib64",
                "$XDG_DATA_HOME/mise/installs/pypi-mcp-proxy-for-aws",
                "$XDG_DATA_HOME/mise/installs/python",
                "$XDG_DATA_HOME/uv/python"
              ],
              "fs_read_file": [
                "/usr/bin/mise",
                "/etc/mime.types", // for fastmcp
                "/etc/ca-certificates/extracted/tls-ca-bundle.pem"
              ],
              "environment": {
                "allow_vars": [
                  "HOME",
                  "XDG_CONFIG_HOME",
                  "XDG_CACHE_HOME",
                  "XDG_STATE_HOME",
                  "AWS_MCP_PROXY_PROFILES",
                  "AWS_PROFILE",
                  "AWS_REGION"
                ]
              },
              "network": {
                "allow_all": true
              }
            }
          }
        }
      }
    }
  }
}

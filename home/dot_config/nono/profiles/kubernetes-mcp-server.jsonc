{
  "$schema": "../nono-profile.schema.json",
  "command_policies": {
    "commands": {
      "kubernetes-mcp-server": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read": [
                "/lib",
                "/lib64",
                "/usr/lib",
                "/usr/lib64",
                "/etc/ssl",
                "$HOME/.kube/configs"
              ],
              "fs_read_file": [
                "/etc/ca-certificates/extracted/tls-ca-bundle.pem"
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  // for kubernetes-mcp-server
                  "HOME",
                  "KUBECONFIG"
                ]
              },
              "network": {
                "allow_all": true
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "../nono-profile.schema.json",
  "extends": "granted",
  "command_policies": {
    "commands": {
      "aws": {
        "can_use": ["granted"],
        "export_env": [
          "HOME",
          "XDG_CONFIG_HOME",
          "XDG_CACHE_HOME",
          "XDG_STATE_HOME",
          "AWS_CONFIG_FILE",
          "AWS_PROFILE"
        ]
      }
    }
  }
}

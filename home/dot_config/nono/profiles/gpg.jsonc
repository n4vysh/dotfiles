{
  "$schema": "../nono-profile.schema.json",
  "command_policies": {
    "credentials": {
      "gpg-agent": {
        "type": "local-socket",
        "path": "$XDG_RUNTIME_DIR/gnupg/S.gpg-agent",
        "mode": "connect"
      }
    },
    "commands": {
      "gpg": {
        "executable": "/usr/bin/gpg",
        "from": {
          "session": {
            "sandbox": {
              "use_credentials": ["gpg-agent"],
              "fs_read": [
                "$TMPDIR" // for git log --show-signature
              ],
              "fs_write": ["$HOME/.gnupg"],
              "environment": {
                "allow_vars": [
                  "HOME", // for ~/.gnupg
                  "DISPLAY" // for GUI pinentry
                ]
              }
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  // for git commit
                  "argv": {
                    "prefix": ["--status-fd=2", "-bsau"]
                  }
                },
                {
                  // for following commands
                  //   - git log --show-signature
                  //   - git verify-commit <commit>
                  "argv": {
                    "prefix": [
                      "--keyid-format=long",
                      "--status-fd=1",
                      "--verify"
                    ]
                  }
                }
              ]
            }
          },
          "granted": {
            "sandbox": {
              "fs_write": ["$HOME/.gnupg"],
              "environment": {
                "allow_vars": [
                  "HOME", // for ~/.gnupg
                  "DISPLAY" // for GUI pinentry
                ]
              }
            }
          },
          "pass": {
            "sandbox": {
              "fs_write": ["$HOME/.gnupg", "$HOME/.password-store"],
              "environment": {
                "allow_vars": [
                  "HOME", // for ~/.gnupg
                  "DISPLAY" // for GUI pinentry
                ]
              }
            }
          },
          "gopass": {
            "sandbox": {
              "fs_write": ["$HOME/.gnupg"],
              "environment": {
                "allow_vars": [
                  "HOME", // for ~/.gnupg
                  "DISPLAY" // for GUI pinentry
                ]
              }
            }
          }
        }
      }
    }
  }
}

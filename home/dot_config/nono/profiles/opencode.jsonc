{
  "$schema": "../nono-profile.schema.json",
  "extends": [
    "nolabs-ai/opencode",
    "dbus",
    "systemd-resolved",
    "git",
    "gh",
    "nvim",
    "gpg",
    "gopass",
    "aws",
    "kubectl",
    "gcx",
    "terraform-mcp-server",
    "github-mcp-server",
    "aws-mcp-server",
    "kubernetes-mcp-server",
    "grafana-mcp-server"
  ],
  "groups": {
    "include": ["mise_manager", "go_runtime", "go_runtime_linux"]
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "$HOME/Workspaces", // ghq root
      "$XDG_DATA_HOME/chezmoi", // dotfiles
      "$XDG_DATA_HOME/rtk/tee"
    ],
    "read": [
      "$XDG_CONFIG_HOME/nono",
      "$XDG_CONFIG_HOME/rumdl",
      "$XDG_CONFIG_HOME/sqlfluff",
      "$XDG_CONFIG_HOME/stylua",
      "$XDG_CONFIG_HOME/yamlfmt",
      "$XDG_CONFIG_HOME/yamllint"
    ]
  },
  "network": {
    "block": false
  },
  "environment": {
    "set_vars": {
      "AWS_CONFIG_FILE": "$HOME/.aws/configs/opencode.ini",
      "KUBECONFIG": "$HOME/.kube/configs/opencode.yaml"
    }
  },
  "command_policies": {
    "session_export_env": ["AWS_CONFIG_FILE", "KUBECONFIG"],
    "commands": {
      "aws": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          },
          "kubectl": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          },
          "kubernetes-mcp-server": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          }
        }
      },
      "mcp-proxy-for-aws": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          }
        }
      },
      "granted": {
        "from": {
          "aws": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          },
          "mcp-proxy-for-aws": {
            "sandbox": {
              "fs_read_file": ["$HOME/.aws/configs/opencode.ini"]
            }
          }
        }
      },
      "kubectl": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read_file": ["$HOME/.kube/configs/opencode.yaml"]
            }
          }
        }
      },
      "kubernetes-mcp-server": {
        "from": {
          "session": {
            "sandbox": {
              "fs_read_file": ["$HOME/.kube/configs/opencode.yaml"]
            }
          }
        }
      }
    }
  }
}

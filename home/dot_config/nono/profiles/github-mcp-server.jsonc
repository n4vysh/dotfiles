{
  "$schema": "../nono-profile.schema.json",
  "command_policies": {
    "commands": {
      "github-mcp-server": {
        "from": {
          "gopass": {
            "sandbox": {
              "fs_read": [
                "/etc/ssl",
                "/lib",
                "/lib64",
                "/usr/lib",
                "/usr/lib64",
                "$XDG_DATA_HOME/mise/installs/aqua-github-github-mcp-server"
              ],
              "fs_read_file": [
                "/usr/bin/mise",
                "/etc/ca-certificates/extracted/tls-ca-bundle.pem",
                "$XDG_CONFIG_HOME/mise/config.toml"
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  // for github-mcp-server
                  "GITHUB_PERSONAL_ACCESS_TOKEN"
                ]
              },
              "network": {
                "allow_all": true
              }
            }
          }
        }
      }
    }
  }
}

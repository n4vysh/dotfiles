{
  "$schema": "../nono-profile.schema.json",
  "command_policies": {
    "commands": {
      "mcp-grafana": {
        "from": {
          "gopass": {
            "sandbox": {
              "fs_read": [
                "/etc/ssl",
                "/lib",
                "/lib64",
                "/usr/lib",
                "/usr/lib64",
                "/etc/ssl"
              ],
              "fs_read_file": [
                "/etc/ca-certificates/extracted/tls-ca-bundle.pem"
              ],
              "environment": {
                "allow_vars": [
                  "PATH",
                  // for mcp-grafana
                  "GRAFANA_ORG_ID",
                  "GRAFANA_URL",
                  "GRAFANA_SERVICE_ACCOUNT_TOKEN"
                ]
              },
              "network": {
                "allow_all": true
              }
            }
          }
        }
      }
    }
  }
}

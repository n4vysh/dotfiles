{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra", // flagship model
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" }
    ]
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra-fast": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        },
        "gpt-6-sol-fast": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        },
        "gpt-6-luna-fast": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        },
        "gpt-6-astra": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        },
        "gpt-6-sol": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        },
        "gpt-6-luna": {
          "settings": {
            "textVerbosity": "low" // keep routine responses concise
          }
        }
      }
    }
  },
  "default_agent": "plan",
  "update": "disable",
  "share": "disabled",
  "plugins": ["@devtheops/opencode-plugin-otel@2.0.0"],
  "agents": {
    // Built-in primary agents
    "title": {
      "model": "openai/gpt-6-luna" // cost-efficient model
    },
    "compaction": { "model": "openai/gpt-6-sol" },
    // Built-in subagents
    "general": { "model": "openai/gpt-6-luna" },
    "explore": { "model": "openai/gpt-6-luna" }
  },
  "permissions": [
    // external_directory: deny
    { "action": "external_directory", "resource": "~", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gcx/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.kube/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    // external_directory: allow
    { "action": "external_directory", "resource": "~/.config/nono/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/chezmoi/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/mise/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/log/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/rtk/tee/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/state/nono/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Workspaces/**", "effect": "allow" }, // ghq root
    // shell:
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "deny" }, // NOTE: use trash command
    { "action": "shell", "resource": "npx *", "effect": "deny" },
    { "action": "shell", "resource": "rtk npx *", "effect": "deny" },
    { "action": "shell", "resource": "bunx *", "effect": "deny" },
    { "action": "shell", "resource": "yarn dlx *", "effect": "deny" },
    { "action": "shell", "resource": "pnpm dlx *", "effect": "deny" },
    { "action": "shell", "resource": "rtk pnpm dlx *", "effect": "deny" },
    { "action": "shell", "resource": "uvx *", "effect": "deny" },
    { "action": "shell", "resource": "* --help", "effect": "allow" },
    { "action": "shell", "resource": "* --version", "effect": "allow" },
    { "action": "shell", "resource": "ctx7 library *", "effect": "allow" },
    { "action": "shell", "resource": "ctx7 docs *", "effect": "allow" },
    { "action": "shell", "resource": "nono profile guide", "effect": "allow" },
    { "action": "shell", "resource": "nono profile list", "effect": "allow" },
    { "action": "shell", "resource": "nono profile show *", "effect": "allow" },
    { "action": "shell", "resource": "nono profile validate *", "effect": "allow" },
    { "action": "shell", "resource": "nono profile groups *", "effect": "allow" },
    { "action": "shell", "resource": "nono why *", "effect": "allow" },
    { "action": "shell", "resource": "nono audit list *", "effect": "allow" },
    { "action": "shell", "resource": "nono audit show *", "effect": "allow" },
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi diff", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi execute-template *", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi ignored", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi managed", "effect": "allow" },
    { "action": "shell", "resource": "chezmoi status", "effect": "allow" },
    { "action": "shell", "resource": "pacman -Si *", "effect": "allow" },
    { "action": "shell", "resource": "pacman -Ss *", "effect": "allow" },
    { "action": "shell", "resource": "pacman -Qi *", "effect": "allow" },
    { "action": "shell", "resource": "pacman -Ql *", "effect": "allow" },
    { "action": "shell", "resource": "pacman -Qo *", "effect": "allow" },
    { "action": "shell", "resource": "yay -Si *", "effect": "allow" },
    { "action": "shell", "resource": "yay -Ss *", "effect": "allow" },
    { "action": "shell", "resource": "semble search *", "effect": "allow" },
    { "action": "shell", "resource": "semble find-related *", "effect": "allow" },
    { "action": "shell", "resource": "defuddle parse *", "effect": "allow" },
    { "action": "shell", "resource": "markitdown *", "effect": "allow" },
    { "action": "shell", "resource": "agent-browser skills get core", "effect": "allow" },
    { "action": "shell", "resource": "hunk session list *", "effect": "allow" },
    { "action": "shell", "resource": "hunk session review *", "effect": "allow" },
    { "action": "shell", "resource": "hunk session get *", "effect": "allow" },
    { "action": "shell", "resource": "hunk session comment add *", "effect": "allow" },
    { "action": "shell", "resource": "hunk session comment apply *", "effect": "allow" },
    { "action": "shell", "resource": "hunk session comment list *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane current --current", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane list", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane read *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane get *", "effect": "allow" },
    { "action": "shell", "resource": "herdr status", "effect": "allow" },
    { "action": "shell", "resource": "herdr workspace list *", "effect": "allow" },
    { "action": "shell", "resource": "herdr tab list *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane layout *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane process-info *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane neighbor *", "effect": "allow" },
    { "action": "shell", "resource": "herdr pane edges *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent list *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent get *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent read *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent explain *", "effect": "allow" },
    { "action": "shell", "resource": "herdr integration status", "effect": "allow" },
    { "action": "shell", "resource": "opencode service status", "effect": "allow" },
    { "action": "shell", "resource": "opencode plugin list", "effect": "allow" },
    { "action": "shell", "resource": "opencode models", "effect": "allow" },
    { "action": "shell", "resource": "opencode session list *", "effect": "allow" },
    { "action": "shell", "resource": "opencode export *", "effect": "allow" },
    { "action": "shell", "resource": "opencode debug *", "effect": "allow" },
    // shell: file discovery and search
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 ls *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "rtk find *", "effect": "allow" },
    { "action": "shell", "resource": "rtk find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "rtk find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "RTK_DISABLED=1 find *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "RTK_DISABLED=1 find *-delete*", "effect": "ask" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "md5sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "shell", "resource": "sha512sum *", "effect": "allow" },
    // shell file reading and comparison
    { "action": "shell", "resource": "rtk read *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 tail *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "sed *-i*", "effect": "ask" },
    { "action": "shell", "resource": "col *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk diff *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 diff *", "effect": "allow" },
    // shell: git
    { "action": "shell", "resource": "rtk git -C*", "effect": "deny" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git -C*", "effect": "deny" },
    { "action": "shell", "resource": "git -C*", "effect": "deny" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git add *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git commit *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git add *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *-d*", "effect": "ask" },
    { "action": "shell", "resource": "git branch *-m*", "effect": "ask" },
    { "action": "shell", "resource": "rtk git branch *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git branch *-d*", "effect": "ask" },
    { "action": "shell", "resource": "rtk git branch *-m*", "effect": "ask" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git branch *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git branch *-d*", "effect": "ask" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git branch *-m*", "effect": "ask" },
    { "action": "shell", "resource": "git config user.*", "effect": "allow" },
    { "action": "shell", "resource": "git config *--get*", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-remote *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git show *", "effect": "allow" },
    { "action": "shell", "resource": "git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git show-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git log *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git log *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git symbolic-ref *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-list *", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git remote show *", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git merge-base *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "git tag", "effect": "allow" },
    { "action": "shell", "resource": "git tag -l *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --sort=* *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --format=* *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --format * *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --contains *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --no-contains *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --merged *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --no-merged *", "effect": "allow" },
    { "action": "shell", "resource": "git tag --points-at *", "effect": "allow" },
    // shell: Formatter & Linter
    { "action": "shell", "resource": "check-merge-conflict *", "effect": "allow" },
    { "action": "shell", "resource": "check-case-conflict *", "effect": "allow" },
    { "action": "shell", "resource": "check-added-large-files *", "effect": "allow" },
    { "action": "shell", "resource": "check-executables-have-shebangs *", "effect": "allow" },
    { "action": "shell", "resource": "check-shebang-scripts-are-executable *", "effect": "allow" },
    { "action": "shell", "resource": "editorconfig-checker *", "effect": "allow" },
    { "action": "shell", "resource": "typos *", "effect": "allow" },
    { "action": "shell", "resource": "ls-lint *", "effect": "allow" },
    { "action": "shell", "resource": "yamlfmt *", "effect": "allow" },
    { "action": "shell", "resource": "yamllint *", "effect": "allow" },
    { "action": "shell", "resource": "rtk yamllint *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 yamllint *", "effect": "allow" },
    { "action": "shell", "resource": "taplo *", "effect": "allow" },
    { "action": "shell", "resource": "tsc *", "effect": "allow" },
    { "action": "shell", "resource": "shfmt *", "effect": "allow" },
    { "action": "shell", "resource": "shellharden *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "rtk shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "selene *", "effect": "allow" },
    { "action": "shell", "resource": "bats *", "effect": "allow" },
    { "action": "shell", "resource": "rtk go -C*", "effect": "deny" },
    { "action": "shell", "resource": "RTK_DISABLED=1 go -C*", "effect": "deny" },
    { "action": "shell", "resource": "go -C*", "effect": "deny" },
    { "action": "shell", "resource": "go fmt *", "effect": "allow" },
    { "action": "shell", "resource": "go list *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "rtk go test *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 go test *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint fmt *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint run *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "gofumpt *", "effect": "allow" },
    { "action": "shell", "resource": "na exec vitest *", "effect": "allow" },
    { "action": "shell", "resource": "na exec prettier *", "effect": "allow" },
    { "action": "shell", "resource": "na exec biome *", "effect": "allow" },
    { "action": "shell", "resource": "nr test", "effect": "allow" },
    { "action": "shell", "resource": "nr format", "effect": "allow" },
    { "action": "shell", "resource": "nr fmt", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "sqlfluff fix *", "effect": "allow" },
    { "action": "shell", "resource": "sqlfluff lint *", "effect": "allow" },
    { "action": "shell", "resource": "prettier *", "effect": "allow" },
    { "action": "shell", "resource": "rtk prettier *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 prettier *", "effect": "allow" },
    { "action": "shell", "resource": "lychee *", "effect": "allow" },
    { "action": "shell", "resource": "actionlint *", "effect": "allow" },
    { "action": "shell", "resource": "zizmor *", "effect": "allow" },
    { "action": "shell", "resource": "lefthook run *", "effect": "allow" },
    { "action": "shell", "resource": "lefthook validate *", "effect": "allow" },
    { "action": "shell", "resource": "renovate-config-validator *", "effect": "allow" },
    // AWS read operations
    { "action": "shell", "resource": "aws * get-* *", "effect": "allow" },
    { "action": "shell", "resource": "aws * describe-* *", "effect": "allow" },
    { "action": "shell", "resource": "aws * list-* *", "effect": "allow" },
    { "action": "shell", "resource": "aws logs start-query *", "effect": "allow" },
    { "action": "shell", "resource": "aws logs filter-log-events *", "effect": "allow" },
    { "action": "shell", "resource": "rtk aws * get-* *", "effect": "allow" },
    { "action": "shell", "resource": "rtk aws * describe-* *", "effect": "allow" },
    { "action": "shell", "resource": "rtk aws * list-* *", "effect": "allow" },
    { "action": "shell", "resource": "rtk aws logs start-query *", "effect": "allow" },
    { "action": "shell", "resource": "rtk aws logs filter-log-events *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 aws * get-* *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 aws * describe-* *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 aws * list-* *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 aws logs start-query *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 aws logs filter-log-events *", "effect": "allow" },
    // shell: docker compose
    { "action": "shell", "resource": "docker compose ps", "effect": "allow" },
    { "action": "shell", "resource": "docker compose logs *", "effect": "allow" },
    { "action": "shell", "resource": "rtk docker compose ps", "effect": "allow" },
    { "action": "shell", "resource": "rtk docker compose logs *", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 docker compose ps", "effect": "allow" },
    { "action": "shell", "resource": "RTK_DISABLED=1 docker compose logs *", "effect": "allow" },
    // shell: kubernetes
    { "action": "shell", "resource": "rtk kubectl --context*", "effect": "deny" },
    { "action": "shell", "resource": "rtk kubectl --namespace*", "effect": "deny" },
    { "action": "shell", "resource": "rtk kubectl -n*", "effect": "deny" },
    { "action": "shell", "resource": "RTK_DISABLED=1 kubectl --context*", "effect": "deny" },
    { "action": "shell", "resource": "RTK_DISABLED=1 kubectl --namespace*", "effect": "deny" },
    { "action": "shell", "resource": "RTK_DISABLED=1 kubectl -n*", "effect": "deny" },

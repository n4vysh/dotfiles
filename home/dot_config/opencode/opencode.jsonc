  ],
  // NOTE: opencode v2 lsp implementation is working progress
  //       https://github.com/anomalyco/opencode/issues/38528
  "lsp": true,
  "formatter": {
    "rumdl": { "command": ["rumdl", "fmt", "$FILE"], "extensions": [".md"] },
    // NOTE: run prettier even without package.json
    //       https://github.com/anomalyco/opencode/blob/v1.14.46/packages/opencode/src/format/formatter.ts#L37-L84
    "prettier": {
      "command": ["prettier", "--trailing-comma", "none", "--write", "$FILE"],
      "extensions": [".json", ".jsonc"]
    },
    "yamlfmt": { "command": ["yamlfmt", "$FILE"], "extensions": [".yml", ".yaml"] },
    "stylua": { "command": ["stylua", "$FILE"], "extensions": [".lua"] }
  },
  "mcp": {
    "servers": {
      "terraform": { "disabled": false, "type": "local", "command": ["terraform-mcp-server"] },
      // NOTE: github-mcp-server not support Dynamic Client Registration
      //       https://github.com/github/github-mcp-server/issues/1396#issuecomment-3895920244
      "github": {
        "disabled": false,
        "type": "local",
        // ```sh
        // gh auth token |
        //   gopass insert envs/github-mcp-server/GITHUB_PERSONAL_ACCESS_TOKEN
        // ```
        "command": ["gopass", "env", "envs/github-mcp-server", "github-mcp-server", "stdio", "--read-only"]
      },
      "aws": {
        "disabled": true,
        "type": "local",
        "command": ["mcp-proxy-for-aws", "https://aws-mcp.us-east-1.api.aws/mcp", "--disable-telemetry"],
        "environment": {
          // ```sh
          // mkdir -p ~/.aws/configs
          // $EDITOR ~/.aws/config ~/.aws/configs/opencode.ini
          // ```
          "AWS_CONFIG_FILE": "{env:HOME}/.aws/configs/opencode.ini",
          "AWS_MCP_PROXY_PROFILES": "n4vysh-common n4vysh-stg n4vysh-prod",
          "AWS_REGION": "ap-northeast-1"
        }
      },
      "kubernetes": {
        "disabled": true,
        "type": "local",
        "command": ["kubernetes-mcp-server", "--read-only"],
        "environment": {
          // ```sh
          // install -d -m 700 ~/.kube/configs
          //
          // # kind
          // KUBECONFIG=~/.kube/config kind create cluster -n sandbox &&
          //   kind export kubeconfig \
          //     --name sandbox \
          //     --kubeconfig ~/.kube/configs/opencode.yaml &&
          //   KUBECONFIG=~/.kube/config kubectx -u &&
          //   KUBECONFIG=~/.kube/configs/opencode.yaml kubectx -u
          //
          // # EKS
          // AWS_CONFIG_FILE="$HOME/.aws/configs/opencode.ini" \
          //   aws eks update-kubeconfig \
          //     --profile <profile name> \
          //     --region ap-northeast-1 \
          //     --name <cluster name> \
          //     --alias <alias name> \
          //     --kubeconfig ~/.kube/configs/opencode.yaml
          // ```
          "KUBECONFIG": "{env:HOME}/.kube/configs/opencode.yaml"
        }
      },
      "grafana_n4vysh": {
        "disabled": true,
        "type": "local",
        // ```sh
        // gopass insert envs/mcp-grafana/n4vysh/GRAFANA_SERVICE_ACCOUNT_TOKEN
        // ```
        "command": ["gopass", "env", "envs/mcp-grafana/n4vysh", "mcp-grafana", "--disable-write", "-t", "stdio"],
        "environment": { "GRAFANA_ORG_ID": "0", "GRAFANA_URL": "https://n4vysh.grafana.net" }
      }
    }
  }
}

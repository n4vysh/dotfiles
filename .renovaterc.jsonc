{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgePypi",
    "security:openssf-scorecard",
    "schedule:monthly",
    ":maintainLockFilesMonthly"
  ],
  "timezone": "Asia/Tokyo",
  "automerge": false, // disable automerge to reduce supply-chain risk
  "prCreation": "not-pending",
  "branchPrefix": "feature/renovate/",
  // Dependency update groups:
  // - github-actions
  // - mise-runtime
  // - mise (+ mise.lock maintenance)
  // - mise-global (+ mise.lock maintenance)
  // - sheldon
  // - chezmoi-external
  // Maximum PRs: 6 x 2 (major/non-major) + 2 lock file maintenance = 14
  "prConcurrentLimit": 14,
  "prHourlyLimit": 14,
  "commitHourlyLimit": 14,
  "separateMajorMinor": true,
  "ignorePaths": [".mise/locks/**", "home/dot_config/mise/locks/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mise runtime used by CI",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/[^/]+\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=jdx/mise\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "depTypeTemplate": "mise-runtime"
    },
    {
      "customType": "regex",
      "description": "Update tagged chezmoi externals",
      "managerFilePatterns": ["/^home\\/\\.chezmoiexternal\\.toml$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?<currentValue>[^/]+)\\.tar\\.gz",
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/refs/tags/(?<currentValue>[^/]+)/[^\\\"\\s]+"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced",
      "depTypeTemplate": "chezmoi-external"
    },
    {
      "customType": "regex",
      "description": "Update commit-pinned chezmoi externals",
      "managerFilePatterns": ["/^home\\/\\.chezmoiexternal\\.toml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s+url = \\\"https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentDigest>[0-9a-f]+)/"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs",
      "depTypeTemplate": "chezmoi-external"
    },
    {
      "customType": "regex",
      "description": "Update tagged Sheldon plugins",
      "managerFilePatterns": [
        "/^home\\/dot_config\\/sheldon\\/plugins\\.toml$/"
      ],
      "matchStrings": [
        "github = \\\"(?<depName>[^\\\"]+)\\\"\\s+tag = \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced",
      "depTypeTemplate": "sheldon"
    },
    {
      "customType": "regex",
      "description": "Update commit-pinned Sheldon plugins",
      "managerFilePatterns": [
        "/^home\\/dot_config\\/sheldon\\/plugins\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\s+rev = \\\"(?<currentDigest>[0-9a-f]+)\\\""
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs",
      "depTypeTemplate": "sheldon"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "commitMessageAction": ":package: bump",
      "groupName": "github-actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group mise runtime updates",
      "matchDepTypes": ["mise-runtime"],
      "commitMessageAction": ":package: bump",
      "groupName": "mise-runtime",
      "groupSlug": "mise-runtime"
    },
    {
      "description": "Group repository development tool updates",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "commitMessageAction": ":package: bump",
      "groupName": "mise",
      "groupSlug": "mise"
    },
    {
      "description": "Group personal environment tool updates",
      "matchManagers": ["mise"],
      "matchFileNames": ["home/dot_config/mise/config.toml"],
      "commitMessageAction": ":package: bump",
      "groupName": "mise-global",
      "groupSlug": "mise-global"
    },
    {
      "description": "Group Sheldon plugin updates",
      "matchDepTypes": ["sheldon"],
      "commitMessageAction": ":package: bump",
      "groupName": "sheldon",
      "groupSlug": "sheldon"
    },
    {
      "description": "Group chezmoi external updates",
      "matchDepTypes": ["chezmoi-external"],
      "commitMessageAction": ":package: bump",
      "groupName": "chezmoi-external",
      "groupSlug": "chezmoi-external"
    },
    {
      "description": "Group mise.lock maintenance",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessageAction": ":package: maintain",
      "commitMessageTopic": "mise.lock"
    }
  ]
}
